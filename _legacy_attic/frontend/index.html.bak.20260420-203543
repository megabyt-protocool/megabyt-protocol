<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MegaByt</title>

<script src="https://unpkg.com/@solana/web3.js@latest/lib/index.iife.js"></script>
<script src="https://unpkg.com/@coral-xyz/anchor@latest/dist/browser/index.js"></script>

<style>
body {
  background: #06060b;
  color: #e0e0f0;
  font-family: Arial;
  margin: 0;
  padding: 0;
}

.container {
  max-width: 900px;
  margin: auto;
  padding: 20px;
  text-align: center;
}

h1 {
  font-size: 32px;
  margin-bottom: 20px;
}

.wallet-btn {
  background: #00c853;
  color: white;
  padding: 10px 20px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
}

.buy-btn {
  background: #00b0ff;
  color: white;
  padding: 10px 20px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
}

.log {
  margin-top: 20px;
  background: #111;
  padding: 10px;
  border-radius: 8px;
  font-size: 12px;
  text-align: left;
}
</style>
</head>

<body>

<div class="container">

<h1>MegaByt</h1>

<button class="wallet-btn" onclick="connectWallet()">Connect Wallet</button>
<button class="buy-btn" onclick="buyTicket()">Buy Ticket</button>

<div class="log" id="log"></div>

</div>

<script>

const PROGRAM_ID = new solanaWeb3.PublicKey("2sq5GDjs2ESDEK2Jpec7je2aAnVJ2w7uZgM1Qh5GgpmS");
const GLOBAL_STATE = new solanaWeb3.PublicKey("AUJCkNYLRPLxBzrPZAjp64i22kcSFNh4aNJ5uiNNTiDv");
const DRAW_PDA = new solanaWeb3.PublicKey("35VeVbr23NmLNVY7VyAUbS7YCEBeaCPwSw2kCN9mf2dR");

const USDT_MINT = new solanaWeb3.PublicKey("HkahNWz3FB53wYNKgZaEYrrC3K9DbQoWuydKM2HPqiUd");
const PRIZE_VAULT = new solanaWeb3.PublicKey("8sEKCpLjLLZzRjwKXfn5ubYhuJu2jdYFa5ngqbTyw7mz");

let provider;
let wallet;

const connection = new solanaWeb3.Connection("https://api.devnet.solana.com");

function log(msg) {
  document.getElementById("log").innerHTML += msg + "<br>";
}

async function connectWallet() {
  wallet = window.solana;
  await wallet.connect();
  provider = new anchor.AnchorProvider(connection, wallet, {});
  anchor.setProvider(provider);

  log("Wallet connected: " + wallet.publicKey.toBase58());
}

async function buyTicket() {
  try {
    log("Preparing buy_ticket...");

    const user = wallet.publicKey;

    const userTokenAccount = await anchor.utils.token.associatedAddress({
      mint: USDT_MINT,
      owner: user
    });

    const ticket = solanaWeb3.Keypair.generate();

    const idl = await (await fetch("../target/idl/megabyt.json")).json();
    const program = new anchor.Program(idl, PROGRAM_ID, provider);

    log("Awaiting Phantom signature...");

    const tx = await program.methods.buyTicket(
      [11,12,34,35,36,37],
      1
    ).accounts({
      user: user,
      globalState: GLOBAL_STATE,
      draw: DRAW_PDA,
      ticket: ticket.publicKey,
      userTokenAccount: userTokenAccount,
      prizeVault: PRIZE_VAULT,
      tokenProgram: anchor.utils.token.TOKEN_PROGRAM_ID,
      systemProgram: solanaWeb3.SystemProgram.programId
    }).signers([ticket]).rpc();

    log("TX: " + tx);
    log("SUCCESS!");

  } catch (err) {
    console.error(err);
    log("ERROR: " + err.message);
  }
}

</script>

</body>
</html>


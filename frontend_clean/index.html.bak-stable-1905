/* ===== TIMER ===== */
function startCountdown(){if(timerIv) clearInterval(timerIv);timerIv=setInterval(tickTimer,1000);tickTimer()}
function tickTimer(){
  try{
    if(typeof drawRaw !== "undefined" && drawRaw){
      var end = drawEndTime || 0;
      var now = Math.floor(Date.now()/1000);

      // AUTO-CLOSE DISABLED FOR MANUAL DEMO MODE.
      // Closing/finalizing/payout must be triggered manually,
      // so the frontend does not open/close draws in a loop.
      if(false && end > 0 && now >= end && !window.__closingTriggered){
        window.__closingTriggered = true;
      }
    }
  }catch(e){console.log(e);}

  var el = document.getElementById("tmr");
  var lbl = document.getElementById("tmrL");
  if(!drawEndTime){el.textContent="--:--:--";el.className="timer";lbl.textContent="No draw";return}
  var diff = drawEndTime - Math.floor(Date.now() / 1000);
  if(diff <= 0){el.textContent="ROUND ENDED";el.className="timer off";lbl.textContent="Awaiting next round";return}
  var h = Math.floor(diff/3600), m = Math.floor((diff%3600)/60), s = diff%60;
  el.textContent = (h<10?"0":"")+h+":"+(m<10?"0":"")+m+":"+(s<10?"0":"")+s;
  el.className = "timer on";
  lbl.textContent = diff < 300 ? "⚠ Closing soon!" : "Time remaining";
}


async function loadOnChainData(){
  try{
    var gsInfo = await conn.getAccountInfo(gsPda);
    if(!gsInfo || !gsInfo.data){ addLog("GlobalState not found on devnet", "ler"); return; }
    gsRaw = new Uint8Array(gsInfo.data);

    ticketPrice  = rU64(gsRaw, O_GS_TICKET_PRICE);
    drawId       = rU64(gsRaw, O_GS_CURRENT_DRAW);
    var totalUsers  = rU64(gsRaw, O_GS_TOTAL_USERS);
    var monthlyPool = rU64(gsRaw, O_GS_MONTHLY_POOL);

    // IMPORTANT: prize_vault must come from GlobalState, not from a hardcoded address.
    vaultPk = rPK(gsRaw, O_GS_PRIZE_VAULT);

    addLog("Program: " + PROG, "lok");
    addLog("GlobalState: " + GS_ADDR, "lok");
    addLog("Draw #" + drawId + " | Price: " + fmt(ticketPrice) + " BYT$ | Users: " + totalUsers, "lei");

    document.getElementById("sM").textContent = fmt(monthlyPool);

    var vaultInfo = await conn.getAccountInfo(vaultPk);

    // Fallback seguro para demo/devnet caso o offset do GlobalState esteja divergente.
    if(!vaultInfo || !vaultInfo.data){
      vaultPk = new solanaWeb3.PublicKey("8sEKCpLjLLZzRjwKXfn5ubYhuJu2jdYFa5ngqbTyw7mz");
      vaultInfo = await conn.getAccountInfo(vaultPk);
    }

    if(vaultInfo && vaultInfo.data){
      var vData = new Uint8Array(vaultInfo.data);
      vaultMint = rPK(vData, O_SPL_MINT);
      var vaultBal = rU64(vData, O_SPL_AMOUNT);
      document.getElementById("sV").textContent = fmt(vaultBal);
      addLog("Vault: " + vaultPk.toBase58(), "lei");
      addLog("Vault mint: " + vaultMint.toBase58(), "lei");
      addLog("Vault balance: " + fmt(vaultBal) + " BYT$", "lei");
    } else {
      document.getElementById("sV").textContent = "—";
      addLog("Prize vault not found!", "ler");
    }

    if(drawId > 0){
      drawPda = findDraw(drawId);
      var drawInfo = await conn.getAccountInfo(drawPda);
      if(drawInfo && drawInfo.data){
        drawRaw = new Uint8Array(drawInfo.data);
        renderDrawData();
        renderPrizeDistribution(drawRaw);
        addLog("Draw #" + drawId + " loaded: " + drawPda.toBase58().slice(0,20) + "…", "lok");
        document.getElementById("bLive").style.display = "inline";
      } else {
        addLog("Draw #" + drawId + " not found on-chain", "lew");
        renderPrizeDistribution(null);
      }
    }

    await loadRecentDraws();
    renderRecentBets();
  } catch(e){
    addLog("Load error: " + e.message, "ler");
  }
}

function renderDrawData(){
  if(!drawRaw) return;

  var id   = rU64(drawRaw, O_D_ID);
  var pool = rU64(drawRaw, O_D_POOL);
  var sold = rU64(drawRaw, O_D_SOLD);
  drawEndTime = rU64(drawRaw, O_D_END_TIME);

  document.getElementById("sD").textContent = "#" + id;
  var rDrawIdEl = document.getElementById("rDrawId");
  if(rDrawIdEl) rDrawIdEl.textContent = "Draw #" + id;
  document.getElementById("sP").textContent = fmt(pool);
  document.getElementById("sT").textContent = sold;
  document.getElementById("pzB").textContent = fmt(pool) + " BYT$";

  startCountdown();

  var rn = [];
  for(var i = 0; i < 6; i++) rn.push(drawRaw[O_D_RESNUMS + i]);
  var rc = drawRaw[O_D_RESCRYP];
  var rEl = document.getElementById("rN");

  if(rn[0] > 0){
    var h = "";
    for(var j = 0; j < 6; j++) h += '<div class="rb">' + rn[j] + '</div>';

async function doBuy(){
  if(!wallet || selectedNumbers.length !== 6 || !selectedCrypto || !drawPda || !vaultMint) return;

  var btn = document.getElementById("bBtn");
  btn.textContent = "Preparing…";
  btn.className = "bb loading";
  btn.disabled = true;

  var sortedNums = selectedNumbers.slice().sort(function(a, b){ return a - b });

  addLog("=== BUY TICKET ===", "lei");
  addLog("Numbers: [" + sortedNums.join(", ") + "]", "lei");
  addLog("Crypto: " + CRYPTO_NAMES[selectedCrypto - 1] + " (#" + selectedCrypto + ")", "lei");

  try{
    var userDrawPda = findUserDrawState(drawPda, wallet);
    var ticketIndex = 0;

    try{
      var udsInfo = await conn.getAccountInfo(userDrawPda);
      if(udsInfo && udsInfo.data && udsInfo.data.length >= 77){
        ticketIndex = rU32(new Uint8Array(udsInfo.data), O_UDS_BOUGHT);
        addLog("UserDrawState exists: tickets_bought = " + ticketIndex, "lei");
      } else {
        addLog("UserDrawState not found — first ticket (index = 0)", "lei");
      }
    }catch(e){
      addLog("First ticket in this draw (index = 0)", "lei");
    }

    var ticketPda = findTicket(drawPda, wallet, ticketIndex);
    var userAta = findATA(vaultMint, wallet);

    addLog("drawPda:      " + drawPda.toBase58(), "lei");
    addLog("userDrawPda:  " + userDrawPda.toBase58(), "lei");
    addLog("ticketPda:    " + ticketPda.toBase58() + " (idx=" + ticketIndex + ", LE=0x" + toHex(wU32(ticketIndex)) + ")", "lei");
    addLog("userAta:      " + userAta.toBase58(), "lei");
    addLog("vaultMint:    " + vaultMint.toBase58(), "lei");
    addLog("prizeVault:   " + vaultPk.toBase58(), "lei");
    addLog("ticketPrice:  " + ticketPrice + " raw (" + fmt(ticketPrice) + " BYT$)", "lei");

    try{
      var ataInfo = await conn.getAccountInfo(userAta);
      if(ataInfo && ataInfo.data){
        var userBal = rU64(new Uint8Array(ataInfo.data), O_SPL_AMOUNT);
        addLog("User balance: " + fmt(userBal) + " BYT$", "lei");
        if(userBal < ticketPrice){
          addLog("INSUFFICIENT BALANCE: " + fmt(userBal) + " < " + fmt(ticketPrice), "ler");
          btn.textContent = "Insufficient BYT$";
          btn.className = "bb error";
          btn.disabled = false;
          setTimeout(function(){ updateBuyButton() }, 3000);
          return;
        }
      } else {
        addLog("Token account not found — you need BYT$ tokens for mint: " + vaultMint.toBase58(), "ler");
        btn.textContent = "No token account";
        btn.className = "bb error";
        btn.disabled = false;
        setTimeout(function(){ updateBuyButton() }, 3000);
        return;
      }
    }catch(e){
      addLog("Balance check warning: " + e.message, "lew");
    }

    var discHash = await crypto.subtle.digest("SHA-256", enc("global:buy_ticket"));
    var disc = new Uint8Array(discHash).slice(0, 8);
    var args = new Uint8Array(7);
    for(var i = 0; i < 6; i++) args[i] = sortedNums[i];
    args[6] = selectedCrypto;
    var ixData = new Uint8Array(15);
    ixData.set(disc, 0);
    ixData.set(args, 8);

    var keys = [
      { pubkey: wallet,      isSigner: true,  isWritable: true  },
      { pubkey: gsPda,       isSigner: false, isWritable: true  },
      { pubkey: drawPda,     isSigner: false, isWritable: true  },
      { pubkey: userDrawPda, isSigner: false, isWritable: true  },
      { pubkey: ticketPda,   isSigner: false, isWritable: true  },
      { pubkey: userAta,     isSigner: false, isWritable: true  },
      { pubkey: vaultPk,     isSigner: false, isWritable: true  },
      { pubkey: tokProg,     isSigner: false, isWritable: false },
      { pubkey: sysProg,     isSigner: false, isWritable: false }
    ];

    var ix = new solanaWeb3.TransactionInstruction({ programId: progId, keys: keys, data: ixData });

    btn.textContent = "Awaiting signature…";
    addLog("Awaiting Phantom signature…", "lew");

    var tx = new solanaWeb3.Transaction().add(ix);
    tx.feePayer = wallet;
    var bh = await conn.getLatestBlockhash("confirmed");
    tx.recentBlockhash = bh.blockhash;

    var signed = await window.solana.signTransaction(tx);

    btn.textContent = "Sending…";
    addLog("Sending to Solana devnet…", "lei");

    var sig = await conn.sendRawTransaction(signed.serialize(), { skipPreflight:false, preflightCommitment:"confirmed" });
    addLog("Tx: " + sig.slice(0, 32) + "…", "lei");

    addLog("Confirming…", "lei");
    await conn.confirmTransaction({signature:sig, blockhash:bh.blockhash, lastValidBlockHeight:bh.lastValidBlockHeight}, "confirmed");

    btn.textContent = "✓ Ticket Minted On-Chain!";
    btn.className = "bb success";

    addLog("CONFIRMED — Ticket #" + ticketIndex + " for Draw #" + drawId, "lok");
    addLogHtml('<span class="lok">[' + new Date().toLocaleTimeString() + '] </span><a class="tl" href="https://explorer.solana.com/tx/' + sig + '?cluster=devnet" target="_blank">' + sig.slice(0, 44) + '… ↗</a>');

    recordBetHistory({
      drawId: drawId,
      ticketIndex: ticketIndex,
      numbers: sortedNums.slice(),
      crypto: selectedCrypto,
      priceRaw: ticketPrice,
      priceLabel: fmt(ticketPrice) + " BYT$",
      wallet: wallet.toBase58(),
      walletShort: wallet.toBase58().slice(0,4) + "…" + wallet.toBase58().slice(-4),
      tx: sig,
      ts: Date.now()
    });

    setTimeout(async function(){ await loadOnChainData(); updateBuyButton() }, 2500);

    setTimeout(function(){
      selectedNumbers = [];
      selectedCrypto = null;
      document.querySelectorAll(".nm.sel").forEach(function(n){ n.classList.remove("sel") });
      document.querySelectorAll(".ch.sel").forEach(function(c){ c.classList.remove("sel") });
      document.getElementById("nC").textContent = "0 / 6 selected";
      updateBuyButton();
    }, 4000);

  }catch(e){
    btn.textContent = "Error — Try Again";
    btn.className = "bb error";
    btn.disabled = false;
    var msg = e.message || String(e);

    if(msg.indexOf("User rejected") !== -1) addLog("Transaction cancelled by user", "lew");
    else if(msg.indexOf("InvalidMint") !== -1) addLog("Mint mismatch — your token account uses a different mint than the vault", "ler");
    else if(msg.indexOf("InvalidTicket") !== -1) addLog("Insufficient balance or invalid ticket (check saldo vs ticket_price)", "ler");
    else if(msg.indexOf("0x1") !== -1 && msg.indexOf("custom program") !== -1) addLog("Insufficient token balance for ticket purchase", "ler");
    else if(msg.indexOf("DrawClosed") !== -1 || msg.indexOf("DrawAlreadyClosed") !== -1) addLog("Draw is already closed", "ler");
    else if(msg.indexOf("DrawStillOpen") !== -1 || msg.indexOf("0x1772") !== -1){ addLog("Draw has expired (end_time passed) — reloading…", "ler"); await loadOnChainData(); }
    else if(msg.indexOf("ConstraintSeeds") !== -1){ addLog("PDA mismatch — reloading draw state…", "ler"); await loadOnChainData(); }
    else addLog(msg.slice(0, 400), "ler");

    if(e.logs){
      for(var li = 0; li < Math.min(e.logs.length, 10); li++) addLog("  " + e.logs[li], "ler");
    }

    setTimeout(function(){ btn.className = "bb"; updateBuyButton() }, 3000);
  }
}


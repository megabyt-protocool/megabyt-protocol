  selectedCrypto = cryptoEl ? parseInt(cryptoEl.dataset.c) : null;

  var nC = document.getElementById("nC");
  if(nC) nC.textContent = selectedNumbers.length + " / 6 selected";
}

function updateBuyButton(){
  syncSelectionFromDom();

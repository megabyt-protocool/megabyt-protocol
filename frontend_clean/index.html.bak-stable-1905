function renderPrizeDistribution(raw){
  var list = document.getElementById("distList");
  var totalWinnersEl = document.getElementById("distTotalWinners");
  var totalPaidEl = document.getElementById("distTotalPaid");
  var ticketsPaidEl = document.getElementById("distTicketsPaid");
  var distStatus = document.getElementById("distStatus");
  var distPaid = document.getElementById("distPaid");

  if(!raw){
    list.innerHTML = '<div class="empty-box">No draw loaded.</div>';
    totalWinnersEl.textContent = "—";
    totalPaidEl.textContent = "—";
    ticketsPaidEl.textContent = "—";
    distStatus.textContent = "Waiting for draw…";
    distPaid.textContent = "Waiting for payout…";
    return;
  }

  var html = "";
  var totalWinners = 0;
  var totalPaid = 0;

  for(var i = 0; i < 10; i++){
    var winners = rU64(raw, O_D_WCOUNTS + i * 8);
    var prize = rU64(raw, O_D_PTIER + i * 8);
    var totalTier = winners * prize;
    totalWinners += winners;
    totalPaid += totalTier;

    html += '<div class="dist-row">';
    html +=   '<div class="dist-faixa">' + TIER_LABELS[i] + '</div>';
    html +=   '<div class="dist-win">' + winners + '</div>';
    var prizeLabel = (winners > 0 && prize === 0) ? "<<span style='color:#f1c40f;font-weight:600'>⚠ < $1.00 → Rolled over</span>" : (fmt(prize) + " BYT$");
    var totalLabel = (winners > 0 && totalTier === 0) ? "< $1.00 → Rolled over" : (fmt(totalTier) + " BYT$");

    html +=   '<div class="dist-prize">' + prizeLabel + '</div>';
    html +=   '<div class="dist-total">' + totalLabel + '</div>';
    html += '</div>';
  }

  list.innerHTML = html;
  totalWinnersEl.textContent = totalWinners;
  totalPaidEl.textContent = fmt(totalPaid) + " BYT$";
  ticketsPaidEl.textContent = rU64(raw, O_D_TICKETS_PAID);

  var status = raw[O_D_STATUS];
  var settlementComplete = raw[O_D_SETTLEMENT_COMPLETE] === 1;
  var isPaid = raw[O_D_IS_PAID] === 1;

  distStatus.textContent = settlementComplete ? ("Settlement Complete • Status " + status) : ("Settlement Pending • Status " + status);
  distPaid.textContent = isPaid ? "Payout Executed" : "Payout Pending";

  var distDrawIdEl = document.getElementById("distDrawId");
  if(distDrawIdEl) distDrawIdEl.textContent = "Draw #" + rU64(raw, O_D_ID);
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>MegaByt Protocol — Dashboard</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap');
:root{
  --bg:#050510;--card:#0a0a1a;--card2:#0d0d22;--bd:#1a1a3a;--bd2:#252550;
  --tx:#e8e8f8;--tx2:#a0a0c0;--mt:#5a5a80;
  --ac:#7c5cfc;--ac2:#9d80ff;--gn:#00e6b8;--gn2:#00ffcc;
  --rd:#ff5555;--or:#ffaa33;--cy:#44ccff;--gd:#ffd740;
  --pink:#ff44aa;
  --grad1:linear-gradient(135deg,#7c5cfc,#00e6b8);
  --r:12px;--f:'Inter',sans-serif;--m:'JetBrains Mono',monospace;
  --glow:0 0 20px rgba(124,92,252,.15)
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--f);background:var(--bg);color:var(--tx);min-height:100vh}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 20% 0%,rgba(124,92,252,.06),transparent 60%),radial-gradient(ellipse at 80% 100%,rgba(0,230,184,.04),transparent 60%);pointer-events:none}
.app{max-width:1100px;margin:0 auto;padding:20px 20px 40px;position:relative;z-index:1}

/* Header */
.hdr{display:flex;justify-content:space-between;align-items:center;padding:16px 0 20px;border-bottom:1px solid var(--bd);margin-bottom:28px}
.logo-box{display:flex;align-items:center;gap:12px}
.logo-icon{width:40px;height:40px;border-radius:10px;background:var(--grad1);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;color:#fff;font-family:var(--m);box-shadow:var(--glow)}
.logo-text{font-family:var(--m);font-size:24px;font-weight:900;background:var(--grad1);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.logo-sub{font-size:10px;color:var(--mt);letter-spacing:1.5px;margin-top:1px}
.hdr-right{display:flex;align-items:center;gap:10px}
.badge{font-size:9px;font-weight:700;padding:4px 10px;border-radius:20px;letter-spacing:.5px}
.badge-net{color:var(--gn);background:rgba(0,230,184,.08);border:1px solid rgba(0,230,184,.2)}
.badge-live{color:var(--rd);background:rgba(255,85,85,.08);border:1px solid rgba(255,85,85,.2);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.w-btn{padding:9px 20px;border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;border:none;font-family:var(--f);transition:.2s;letter-spacing:.3px}
.w-btn.w-connect{background:var(--ac);color:#fff;box-shadow:0 4px 15px rgba(124,92,252,.3)}
.w-btn.w-connect:hover{background:var(--ac2);transform:translateY(-1px)}
.w-btn.w-connected{background:rgba(0,230,184,.1);color:var(--gn);border:1px solid rgba(0,230,184,.25)}

/* Stats row */
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:24px}
.st{text-align:center;padding:18px 10px;background:var(--card);border:1px solid var(--bd);border-radius:var(--r);position:relative;overflow:hidden}
.st::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.st.s1::before{background:var(--ac)}.st.s2::before{background:var(--gn)}.st.s3::before{background:var(--or)}.st.s4::before{background:var(--cy)}.st.s5::before{background:var(--gd)}
.sv{font-size:26px;font-weight:900;font-family:var(--m);margin-bottom:2px}
.sl{font-size:9px;color:var(--mt);text-transform:uppercase;letter-spacing:.8px}

/* Grid */
.cols{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.one-col{margin-bottom:14px}

/* Card */
.card{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:20px;position:relative;overflow:hidden}
.card-glow{box-shadow:var(--glow)}
.ct{font-size:10px;text-transform:uppercase;letter-spacing:1.8px;color:var(--mt);margin-bottom:12px;font-weight:700}

/* Timer */
.timer{font-family:var(--m);font-size:42px;font-weight:900;text-align:center;padding:10px 0;letter-spacing:2px}
.timer.on{color:var(--gn);text-shadow:0 0 30px rgba(0,230,184,.3)}
.timer.off{color:var(--rd);font-size:18px;text-shadow:0 0 20px rgba(255,85,85,.3)}
.timer-lbl{text-align:center;font-size:10px;color:var(--mt);margin-top:4px}

/* Prize */
.prize-big{font-family:var(--m);font-size:36px;font-weight:900;text-align:center;color:var(--gd);padding:10px 0;text-shadow:0 0 30px rgba(255,215,64,.2)}
.prize-sub{text-align:center;font-size:11px;color:var(--mt);margin-top:2px}

/* Split bar */
.sbar{display:flex;height:8px;border-radius:4px;overflow:hidden;margin:10px 0 8px;gap:1px}
.sseg{height:100%}
.sleg{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.si{font-size:9px;color:var(--mt);display:flex;align-items:center;gap:4px}
.sd{width:8px;height:8px;border-radius:50%}

/* Num grid */
.ng{display:flex;flex-wrap:wrap;gap:4px;justify-content:center}
.nm{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;border:2px solid var(--bd);background:transparent;color:var(--mt);cursor:pointer;transition:.15s;user-select:none;font-family:var(--m)}
.nm:hover{border-color:var(--ac);color:var(--tx)}
.nm.sel{border-color:var(--ac);background:rgba(124,92,252,.2);color:#fff;box-shadow:0 0 10px rgba(124,92,252,.3)}
.nm.drawn{border-color:var(--gd);background:rgba(255,215,64,.08);color:var(--gd)}

/* Chips */
.chips{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-top:8px}
.ch{padding:5px 14px;border-radius:20px;font-size:10px;border:1px solid var(--bd);background:transparent;color:var(--mt);cursor:pointer;transition:.15s;font-weight:600;letter-spacing:.3px}
.ch:hover{border-color:var(--or);color:var(--tx)}
.ch.sel{border-color:var(--or);background:rgba(255,170,51,.12);color:var(--or);box-shadow:0 0 10px rgba(255,170,51,.15)}

/* Buy */
.bb{width:100%;padding:14px;border-radius:10px;font-size:15px;font-weight:800;cursor:pointer;border:none;font-family:var(--f);margin-top:16px;transition:.2s;letter-spacing:.5px}
.bb:disabled{opacity:.3;cursor:not-allowed;background:var(--card2);color:var(--mt)}
.bb.ready{background:var(--grad1);color:#fff;box-shadow:0 4px 20px rgba(124,92,252,.35)}
.bb.ready:hover{transform:translateY(-2px);box-shadow:0 6px 25px rgba(124,92,252,.45)}
.bb.loading{background:var(--card2);color:var(--cy)}
.bb.success{background:var(--gn);color:#000;box-shadow:0 4px 20px rgba(0,230,184,.3)}
.bb.error{background:var(--rd);color:#fff}

/* Result */
.rballs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:8px 0}
.rb{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;font-family:var(--m);background:rgba(255,215,64,.06);border:2px solid var(--gd);color:var(--gd)}
.rb.cr{border-color:var(--or);color:var(--or);background:rgba(255,170,51,.06);font-size:10px}

/* VRF */
.vr{display:flex;gap:4px;align-items:baseline;margin-bottom:6px}
.vl{color:var(--gn);font-weight:700;font-size:9px;text-transform:uppercase;font-family:var(--m);min-width:70px}
.vv{font-size:10px;font-family:var(--m);color:var(--mt);word-break:break-all}

/* Recent history */
.hist-wrap{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
.hist-list{display:flex;flex-direction:column;gap:10px}
.hist-item{background:var(--card2);border:1px solid var(--bd);border-radius:10px;padding:12px}
.hist-top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}
.hist-title{font-size:12px;font-weight:800;color:var(--tx)}
.hist-meta{font-size:10px;color:var(--mt);font-family:var(--m)}
.hist-balls{display:flex;gap:6px;flex-wrap:wrap}
.hb{min-width:28px;height:28px;padding:0 8px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;font-family:var(--m);border:1px solid var(--bd);background:rgba(124,92,252,.08);color:var(--tx)}
.hb.win{border-color:var(--gd);color:var(--gd);background:rgba(255,215,64,.08)}
.hb.crypto{border-color:var(--or);color:var(--or);background:rgba(255,170,51,.08)}
.hist-sub{margin-top:8px;font-size:10px;color:var(--mt);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.empty-box{color:var(--mt);font-size:11px;text-align:center;padding:16px 8px;border:1px dashed var(--bd);border-radius:10px;background:rgba(255,255,255,.01)}

/* Prize distribution */
.dist-head{display:grid;grid-template-columns:1.4fr .8fr 1fr 1fr;gap:10px;padding:0 0 10px;border-bottom:1px solid var(--bd);margin-bottom:10px}
.dist-head div{font-size:10px;color:var(--mt);text-transform:uppercase;letter-spacing:.8px;font-weight:700}
.dist-list{display:flex;flex-direction:column;gap:8px}
.dist-row{display:grid;grid-template-columns:1.4fr .8fr 1fr 1fr;gap:10px;align-items:center;background:var(--card2);border:1px solid var(--bd);border-radius:10px;padding:10px 12px}
.dist-row div{font-size:11px}
.dist-faixa{font-weight:700;color:var(--tx)}
.dist-win{color:var(--gn);font-family:var(--m)}
.dist-prize,.dist-total{color:var(--gd);font-family:var(--m)}
.dist-sum{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:12px;padding-top:12px;border-top:1px solid var(--bd);font-size:11px;color:var(--mt)}
.dist-sum b{color:var(--tx)}
.badge-ok{display:inline-flex;align-items:center;gap:6px;font-size:10px;border-radius:999px;padding:5px 10px;border:1px solid rgba(0,230,184,.2);background:rgba(0,230,184,.08);color:var(--gn)}
.badge-soft{display:inline-flex;align-items:center;gap:6px;font-size:10px;border-radius:999px;padding:5px 10px;border:1px solid rgba(124,92,252,.2);background:rgba(124,92,252,.08);color:var(--ac2)}

/* Log */
.log{background:#06060e;border:1px solid var(--bd);border-radius:var(--r);padding:10px;font-family:var(--m);font-size:10px;color:var(--mt);max-height:220px;overflow-y:auto;margin-top:8px}
.le{margin-bottom:2px;line-height:1.4}
.lok{color:var(--gn)}.ler{color:var(--rd)}.lei{color:var(--cy)}.lew{color:var(--or)}
.tl{color:var(--cy);text-decoration:none}.tl:hover{text-decoration:underline}

/* Footer */
.footer{text-align:center;padding:24px 0;color:var(--mt);font-size:10px;border-top:1px solid var(--bd);margin-top:24px}
.footer a{color:var(--cy);text-decoration:none}.footer a:hover{text-decoration:underline}

@media(max-width:768px){
  .stats{grid-template-columns:repeat(3,1fr)}
  .cols{grid-template-columns:1fr}
  .hist-wrap{grid-template-columns:1fr}
  .dist-head,.dist-row{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){.stats{grid-template-columns:repeat(2,1fr)}}
</style>
</head>

var O_UDS_BOUGHT = 72;
var O_SPL_MINT   = 0;
var O_SPL_AMOUNT = 64;

/* ===== HELPERS ===== */
function rU64(b,o){var lo=(b[o]|(b[o+1]<<8)|(b[o+2]<<16)|(b[o+3]<<24))>>>0;var hi=(b[o+4]|(b[o+5]<<8)|(b[o+6]<<16)|(b[o+7]<<24))>>>0;return hi*4294967296+lo}
function rU32(b,o){return(b[o]|(b[o+1]<<8)|(b[o+2]<<16)|(b[o+3]<<24))>>>0}
function rPK(b,o){return new PK(b.slice(o,o+32))}
function wU32(v){var b=new Uint8Array(4);b[0]=v&0xff;b[1]=(v>>>8)&0xff;b[2]=(v>>>16)&0xff;b[3]=(v>>>24)&0xff;return b}
function wU64(v){var b=new Uint8Array(8);var lo=v>>>0;var hi=(v/4294967296)>>>0;b[0]=lo&0xff;b[1]=(lo>>>8)&0xff;b[2]=(lo>>>16)&0xff;b[3]=(lo>>>24)&0xff;b[4]=hi&0xff;b[5]=(hi>>>8)&0xff;b[6]=(hi>>>16)&0xff;b[7]=(hi>>>24)&0xff;return b}
function toHex(b){var s="";for(var i=0;i<b.length;i++)s+=("0"+b[i].toString(16)).slice(-2);return s}
function enc(s){return new TextEncoder().encode(s)}
function fmt(raw){return(raw/1e6).toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2})}
function fmtShortTs(ts){try{return new Date(ts).toLocaleString("en-US",{month:"short",day:"2-digit",hour:"2-digit",minute:"2-digit"})}catch(e){return "—"}}
function safeJsonParse(str,fallback){try{return JSON.parse(str)}catch(e){return fallback}}

/* ===== PDA ===== */
function findDraw(id){return PK.findProgramAddressSync([enc("draw-v3"), wU64(id)], progId)[0]}
function findUserDrawState(drawKey, userKey){
  return PK.findProgramAddressSync([enc("user-draw"), drawKey.toBytes(), userKey.toBytes()], progId)[0]
}
function findTicket(drawKey, userKey, ticketIndex){
  return PK.findProgramAddressSync([enc("ticket"), drawKey.toBytes(), userKey.toBytes(), wU32(ticketIndex)], progId)[0]
}
function findATA(mintKey, ownerKey){
  return PK.findProgramAddressSync([ownerKey.toBytes(), tokProg.toBytes(), mintKey.toBytes()], ataProg)[0]
}


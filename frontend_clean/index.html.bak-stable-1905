    rEl.innerHTML = h;
    document.getElementById("rC").textContent = (CRYPTO_NAMES[rc-1] || rc) + " (#" + rc + ")";
    document.querySelectorAll(".nm").forEach(function(el){
      if(rn.indexOf(parseInt(el.dataset.n)) !== -1) el.classList.add("drawn");
    });
  } else {
    rEl.innerHTML = '<span style="color:var(--mt);font-size:11px">Draw in progress — no results yet</span>';
    document.getElementById("rC").textContent = "";
  }

  document.getElementById("vA").textContent = rPK(drawRaw, O_D_RA).toBase58();
  document.getElementById("vS").textContent = toHex(drawRaw.slice(O_D_SEED, O_D_SEED + 32));
  var cs = rU64(drawRaw, O_D_SLOT);
  document.getElementById("vL").textContent = cs > 0 ? cs.toString() : "—";
  document.getElementById("eL").href = "https://explorer.solana.com/address/" + drawPda.toBase58() + "?cluster=devnet";
}

/* ===== HISTORY ===== */
async function loadRecentDraws(){
  var box = document.getElementById("recentDraws");
  if(!drawId){
    box.innerHTML = '<div class="empty-box">No draw history available yet.</div>';
    return;
  }

  box.innerHTML = '<div class="empty-box">Loading latest results…</div>';

  var items = [];
  var minDraw = Math.max(1, drawId - 50);

  for(var id = drawId; id >= minDraw && items.length < 10; id--){
    try{
      var dp = findDraw(id);
      var info = await conn.getAccountInfo(dp);
      if(!info || !info.data) continue;

      var raw = new Uint8Array(info.data);
      var nums = [];
      for(var n = 0; n < 6; n++) nums.push(raw[O_D_RESNUMS + n]);
      var crypto = raw[O_D_RESCRYP];
      var pool = rU64(raw, O_D_POOL);
      var sold = rU64(raw, O_D_SOLD);
      var endTime = rU64(raw, O_D_END_TIME);
      var status = raw[O_D_STATUS];
      var isReady = nums[0] > 0;

      if(isReady && status === 3){
        items.push({id:id,nums:nums,crypto:crypto,pool:pool,sold:sold,endTime:endTime,status:status});
      }
    }catch(e){}
  }

  if(!items.length){
    box.innerHTML = '<div class="empty-box">No finalized draw results found yet.</div>';
    return;
  }

  var html = "";
  items.forEach(function(item){
    html += '<div class="hist-item">';
    html +=   '<div class="hist-top">';
    html +=     '<div class="hist-title">Draw #' + item.id + '</div>';
    html +=     '<div class="hist-meta">' + fmtShortTs(item.endTime * 1000) + '</div>';
    html +=   '</div>';
    html +=   '<div class="hist-balls">';
    for(var i = 0; i < item.nums.length; i++) html += '<div class="hb win">' + item.nums[i] + '</div>';
    html +=     '<div class="hb crypto">' + (CRYPTO_NAMES[item.crypto-1] || ('#' + item.crypto)) + '</div>';
    html +=   '</div>';
    html +=   '<div class="hist-sub">';
    html +=     '<span>Pool: ' + fmt(item.pool) + ' BYT$</span>';
    html +=     '<span>Tickets: ' + item.sold + '</span>';
    html +=     '<span>Finalized</span>';
    html +=   '</div>';
    html += '</div>';
  });
  box.innerHTML = html;
}



function toggleNumber(el){
  var n = parseInt(el.dataset.n);
  if(el.classList.contains("sel")){
    el.classList.remove("sel");
    selectedNumbers = selectedNumbers.filter(function(x){ return x !== n });
  } else {
    if(selectedNumbers.length >= 6) return;
    el.classList.add("sel");
    selectedNumbers.push(n);
  }
  document.getElementById("nC").textContent = selectedNumbers.length + " / 6 selected";
  updateBuyButton();
}
function pickCrypto(el){
  document.querySelectorAll(".ch").forEach(function(c){ c.classList.remove("sel") });
  el.classList.add("sel");
  selectedCrypto = parseInt(el.dataset.c);
  updateBuyButton();
}
function syncSelectionFromDom(){
  selectedNumbers = Array.from(document.querySelectorAll(".nm.sel"))
    .map(function(el){ return parseInt(el.dataset.n); })
    .filter(Boolean)
    .sort(function(a,b){ return a-b; });


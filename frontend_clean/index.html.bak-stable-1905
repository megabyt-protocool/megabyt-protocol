  if(selectedNumbers.length < 6){btn.textContent="Select " + (6 - selectedNumbers.length) + " more number" + (6 - selectedNumbers.length > 1 ? "s" : "");btn.disabled=true;btn.className="bb";return}
  if(!selectedCrypto){btn.textContent="Select a crypto prediction";btn.disabled=true;btn.className="bb";return}
